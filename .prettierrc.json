{
  "printWidth": 120,
  "singleQuote": true,
  "quoteProps": "preserve",
  "bracketSpacing": false,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "web/**/*.js",
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
