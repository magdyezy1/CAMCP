{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": ".", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"],
    "resolveJsonModule": true, "declaration": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "server/**/*.ts", "tests/**/*.ts", "tools/**/*.ts", "generated/**/*.ts"]
}
