          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "start",
                "exchange",
                "refresh",
                "status",
                "disconnect"
              ]
            },
            "code": {
              "type": "string",
              "description": "OAuth authorization code for exchange."
            },
            "state": {
              "type": "string",
              "description": "Signed OAuth state returned by start."
            },
            "redirect_uri": {
              "type": "string",
              "format": "uri",
              "description": "OAuth redirect URI. Defaults to GOOGLE_ANALYTICS_REDIRECT_URI or /auth/google-analytics."
            },
            "connection_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional GA4 connection ID."
            },
            "dry_run": {
