{
  "name": "amcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AMCP advertising workspace, OAuth connections, and reviewed MCP campaign operations",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/stdio.js",
    "start:http": "node dist/server/http.js",
    "worker": "node dist/server/worker.js",
    "admin": "node dist/tools/admin.js",
    "verify:reads": "node dist/tools/verify-reads.js",
    "test:capture": "node --test tools/catalog/core.test.mjs",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js tests/*.test.mjs",
    "capture:normalize": "node tools/catalog/normalize.mjs",
    "generate": "node codegen/generate.mjs",
    "generate:check": "node codegen/generate.mjs --check",
    "generate:vendor:check": "node tools/fetch-vendor-specs.mjs --generate-only --check",
    "generate:wsdl:check": "node tools/microsoft-specs.mjs --generate-only --check",
    "contracts:generate": "npm run build && node dist/tools/generate-contracts.js",
    "contracts:check": "node dist/tools/generate-contracts.js --check",
    "providers:lifecycle": "node dist/tools/provider-lifecycle.js",
    "test:sandbox": "node dist/tools/live-sandbox.js",
    "report": "node dist/tools/report.js",
    "check:web": "node tools/check-web.mjs",
    "providers:check": "node dist/tools/provider-drift.js",
    "release:assemble": "node tools/prepare-public-release.mjs",
    "check": "npm run generate:check && npm run generate:vendor:check && npm run generate:wsdl:check && npm run generate:feeds:check && npm test && npm run test:capture && npm run report && npm run check:web && npm run providers:check && npm run providers:lifecycle && npm run contracts:check && npm run contracts:actions:check",
    "contracts:actions": "npm run build && node dist/tools/action-contracts.js",
    "contracts:actions:check": "node dist/tools/action-contracts.js --check",
    "generate:feeds:check": "node tools/google-asset-set-fields.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "jose": "6.2.11",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
