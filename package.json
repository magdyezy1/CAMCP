{
  "name": "amcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AMCP advertising workspace, OAuth connections, and reviewed MCP campaign operations",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build-release-identity.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"server/**/*.ts\" \"tools/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\" \"codegen/**/*.mjs\" \"deploy/**/*.mjs\" \"web/**/*.{js,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"server/**/*.ts\" \"tools/**/*.{ts,mjs}\" \"tests/**/*.{ts,mjs}\" \"codegen/**/*.mjs\" \"deploy/**/*.mjs\" \"web/**/*.{js,css}\"",
    "start": "node dist/server/stdio.js",
    "start:http": "node dist/server/http.js",
    "worker": "node dist/server/worker.js",
    "admin": "node dist/tools/admin.js",
    "verify:reads": "node dist/tools/verify-reads.js",
    "test:capture": "node --test tools/catalog/core.test.mjs",
    "test": "npm run build && node tools/test-suite.mjs",
    "test:serial": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js tests/*.test.mjs",
    "test:related": "node tools/related-tests.mjs",
    "benchmark:workbooks": "npm run build && node tools/benchmark-workbook-setup.mjs",
    "benchmark:evidence": "npm run build && node tools/benchmark-evidence-index.mjs",
    "benchmark:schedules": "npm run build && node tools/benchmark-schedules.mjs",
    "benchmark:workers": "npm run build && node tools/benchmark-workers.mjs",
    "benchmark:worker-health": "npm run build && node tools/benchmark-worker-health.mjs",
    "capture:normalize": "node tools/catalog/normalize.mjs",
    "generate": "node codegen/generate.mjs",
    "generate:check": "node codegen/generate.mjs --check",
    "generate:vendor:check": "node tools/fetch-vendor-specs.mjs --generate-only --check",
    "generate:wsdl:check": "node tools/microsoft-specs.mjs --generate-only --check",
    "contracts:generate": "npm run build && node dist/tools/generate-contracts.js",
    "contracts:check": "node dist/tools/generate-contracts.js --check",
    "providers:lifecycle": "node dist/tools/provider-lifecycle.js",
    "providers:sunsets": "node dist/tools/provider-sunsets.js",
    "test:sandbox": "node dist/tools/live-sandbox.js",
    "report": "node dist/tools/report.js",
    "check:web": "node tools/check-web.mjs",
    "check:browser": "npm run build && node tools/browser-workflow-qa.mjs",
    "providers:check": "node dist/tools/provider-drift.js",
    "release:assemble": "node tools/prepare-public-release.mjs",
    "release:verify": "node tools/verify-public-release.mjs",
    "check": "npm run format:check && npm run generate:check && npm run generate:vendor:check && npm run generate:wsdl:check && npm run generate:feeds:check && npm run generate:bids:check && npm test && npm run test:capture && npm run report -- --check && npm run check:web && npm run providers:check && npm run providers:lifecycle && npm run providers:sunsets && npm run contracts:check && npm run contracts:actions:check && npm run docs:index:check",
    "contracts:actions": "npm run build && node dist/tools/action-contracts.js",
    "contracts:actions:check": "node dist/tools/action-contracts.js --check",
    "docs:index": "node tools/docs-index.mjs",
    "docs:index:check": "node tools/docs-index.mjs --check",
    "generate:feeds:check": "node tools/google-asset-set-fields.mjs --check",
    "generate:bids": "node tools/google-bid-fields.mjs",
    "generate:bids:check": "node tools/google-bid-fields.mjs --check",
    "check:public-website": "node tools/check-public-website.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bidi-js": "1.0.3",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "fontkit": "2.0.4",
    "jose": "6.2.11",
    "pdfkit": "0.20.2",
    "zod": "4.5.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.13.3",
    "@types/pdfkit": "0.17.6",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
