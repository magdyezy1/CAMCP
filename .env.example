MIRROR_DB=.runtime/mirror.sqlite
# Generate locally with `npm run admin -- keygen` and inject using your secret manager.
MIRROR_MASTER_KEY=
# Optional private directory for backup staging (default: the system temporary directory). It needs about three
# database sizes free; see docs/OPERATIONS.md, "Backups that complete".
AMCP_BACKUP_TMPDIR=
MIRROR_MODE=strict
MIRROR_FLAGS={}
MIRROR_TENANT_ID=local
MIRROR_HOST=127.0.0.1
MIRROR_PORT=4317
# Required for external binding behind your TLS reverse proxy.
# MIRROR_PUBLIC_ORIGIN=https://mcp.example.com
# New connections default to read + reviewed write access. Set false for a read-only deployment.
# Existing grants are preserved; see docs/WRITE-OPERATIONS.md.
MIRROR_ALLOW_WRITES=true
# Optional, true or false (default false). With MIRROR_ALLOW_WRITES=false, true lets amcp_campaign validate_provider ask
# Google Ads or Meta to validate a request without applying it. It still needs the account's write grant and is audited
# before it is sent. Ignored when writes are allowed (validation is then available).
AMCP_PROVIDER_VALIDATION=false
# Reviewed-write execution switches (WRT-04/WRT-05), each optional; unset keeps the default shown.
# false records every refusal after the claim as uncertain again, instead of releasing a request that was never sent.
# AMCP_WRITE_NOT_SENT_RELEASE=true
# false stops serializing executes of one target (an advisory lock per read target).
# AMCP_WRITE_TARGET_LOCK=true
# How long (ms, at most 60000) a second execute of a target waits for the first before STATE_BUSY.
# AMCP_WRITE_TARGET_WAIT_MS=10000
# Seconds each group part is given (0-120; 0 turns the per-part time budget off). Unset: twice the slowest part's
# preparation, at least 3 s.
# AMCP_WRITE_GROUP_PART_SECONDS=
# false accepts a plan approval by plan_hash alone, without its summary_hash.
# AMCP_PLAN_SUMMARY_HASH=true
# Local stdio only: reader or operator. Operator also requires MIRROR_ALLOW_WRITES=true.
MIRROR_ROLE=operator

# Website: final production origin. During initial Railway setup use its generated HTTPS URL.
AMCP_PUBLIC_ORIGIN=https://amcp.shop
# At least 16 characters; generate a unique strong password and store only in Railway variables.
AMCP_ADMIN_PASSWORD=
# Optional hash instead of the plaintext: `npm run build && npm run admin -- password-hash` reads the password from
# standard input and prints one. Changing the password (or its hash) signs out administrator sessions and ends the
# MCP access approved from them.
AMCP_ADMIN_PASSWORD_HASH=
AMCP_TENANT_ID=local
AMCP_RUN_WORKER=true
# Production refuses a database outside a persistent mount on its own device (Railway supplies RAILWAY_VOLUME_MOUNT_PATH).
# AMCP_DATA_MOUNT=/data
# Local and development use only: start in production without a verified volume.
# AMCP_ALLOW_EPHEMERAL_DB=false
# How long a shutdown waits for running work to settle (ms); keep the platform's stop window longer.
# AMCP_SHUTDOWN_GRACE_MS=25000
# Optional free space (MiB) media admission keeps on the database volume; default the larger of 256 MiB and 10% of
# the volume, capped at 1 GiB. Uploads that would go below it are refused with STORAGE_LOW (docs/OPERATIONS.md).
# AMCP_STORAGE_FLOOR_MB=
# Optional for one release after upgrading: v1 keeps writing the older media chunk format so a rollback can read it.
# AMCP_MEDIA_CHUNK_FORMAT=v1
# Where rate limits read the client address: socket, xff-cidrs, railway or railway+cloudflare (any other value stops
# start-up). On Railway behind Cloudflare proxying use railway+cloudflare (owner decision D5): X-Real-IP, then
# CF-Connecting-IP only when X-Real-IP is a Cloudflare edge address. Unset keeps the earlier behavior: xff-cidrs when
# AMCP_TRUSTED_PROXY_CIDRS is set, otherwise socket. See docs/DEPLOY-RAILWAY.md.
AMCP_CLIENT_IP_SOURCE=
# Only for AMCP_CLIENT_IP_SOURCE=xff-cidrs (other hosts): exact CIDRs of your immediate proxy and any additional
# trusted hops. Railway publishes none; leave it empty there. Do not use blanket private networks.
AMCP_TRUSTED_PROXY_CIDRS=
# Optional exact browser origins whose MCP requests are accepted, such as https://claude.ai. Empty refuses every
# browser origin except AMCP's own; MCP clients that run on a server send no Origin and are unaffected.
AMCP_MCP_ALLOWED_ORIGINS=
# /mcp request bounds (owner decision D6; empty keeps the default, an invalid value stops start-up).
# AMCP_MCP_BATCH_MAX: 1 refuses every JSON-RPC batch; 2-10 accept that many items, for protocol 2025-03-26 only.
# Per actor (an OAuth connector or an API key): AMCP_MCP_RATE_PER_MINUTE (default 60; 0 turns it off),
# AMCP_MCP_RATE_BURST (default 20) and AMCP_MCP_MAX_IN_FLIGHT (default 4 per instance; 0 turns it off).
AMCP_MCP_BATCH_MAX=
AMCP_MCP_RATE_PER_MINUTE=
AMCP_MCP_RATE_BURST=
AMCP_MCP_MAX_IN_FLIGHT=
# Optional: seconds (0-60, default 60) a just-rotated MCP refresh token may be presented again, as two tabs or a lost
# response do, without ending the connection. 0 restores strict rotation. See docs/OAUTH-HARDENING.md.
AMCP_MCP_REFRESH_REUSE_SECONDS=
# MCP clients may identify themselves with an HTTPS client metadata document (CIMD) instead of registering; AMCP fetches
# it from public addresses only, without redirects, at most 10 KB. Set off to accept registered clients only, or list
# exact host names (comma-separated) to accept documents from those hosts only.
AMCP_MCP_CLIENT_METADATA=
AMCP_MCP_CLIENT_METADATA_HOSTS=
# Short-lived rollback only: `fingerprint` restores the old token-byte login fence, under which AMCP's own token
# refresh interrupts in-flight reads. The default `revision` fences on the login revision; see docs/OPERATIONS.md.
# AMCP_AUTHORITY_FENCE=revision
# In-place reauthorization is on for every browser-OAuth platform. List platform IDs (for example meta,linkedin) or
# `all` to turn it off again and leave "Connect another" as the only renewal path.
# AMCP_REAUTHORIZATION_DISABLED=
# Rollback only: `2` returns the capability graph's version 2 dependency placeholders (`requires_evidence`) instead of
# version 3 resolved dependencies.
# AMCP_CAPABILITY_GRAPH_VERSION=3
# Set MIRROR_DB=/data/mirror.sqlite on Railway and attach a persistent volume at /data.
# Register each callback at https://amcp.shop/api/auth/<platform>/callback.
AMCP_GOOGLE_CLIENT_ID=
AMCP_GOOGLE_CLIENT_SECRET=
# Google Ads API access belongs to this OAuth client's Cloud project. In Google Cloud > Google Ads API >
# Overview, Explorer or higher permits production reporting. Developer tokens were sunset on 2026-09-09:
# AMCP never sends AMCP_GOOGLE_DEVELOPER_TOKEN and warns at startup while it is set, so leave it unset.
# AMCP_GOOGLE_DEVELOPER_TOKEN=
AMCP_GOOGLE_LOGIN_CUSTOMER_ID=
# Microsoft Advertising/Bing uses a separate Microsoft app and developer token.
# Register https://amcp.shop/api/auth/microsoft/callback; scopes: msads.manage + offline_access.
AMCP_MICROSOFT_CLIENT_ID=
AMCP_MICROSOFT_CLIENT_SECRET=
AMCP_MICROSOFT_DEVELOPER_TOKEN=
# Optional dedicated Google Cloud OAuth apps. When BOTH fields are unset, use AMCP_GOOGLE_CLIENT_ID/SECRET.
# Register /api/auth/ga4/callback, /api/auth/gtm/callback and /api/auth/gsc/callback separately.
# Enable Analytics Admin + Data APIs, Tag Manager API, and Search Console API in the OAuth app project.
AMCP_GA4_CLIENT_ID=
AMCP_GA4_CLIENT_SECRET=
AMCP_GTM_CLIENT_ID=
AMCP_GTM_CLIENT_SECRET=
# Optional explicit scope override; account/user administration is never added to defaults.
# For administrator workflows, an owner may set AMCP_GTM_SCOPES to the required existing
# scopes plus https://www.googleapis.com/auth/tagmanager.manage.accounts and/or
# https://www.googleapis.com/auth/tagmanager.manage.users, then reconnect that identity.
AMCP_GSC_CLIENT_ID=
AMCP_GSC_CLIENT_SECRET=
AMCP_META_CLIENT_ID=
AMCP_META_CLIENT_SECRET=
# Optional Facebook Login for Business configuration ID from your Meta app.
AMCP_META_CONFIG_ID=
# Exchange initial Meta user token for a long-lived token; actual provider lifetime is retained.
AMCP_META_LONG_LIVED_TOKEN=true
# Optional professional Instagram existing-post discovery, after Meta approval.
# Overrides the complete scope list; reauthorize affected logins afterwards.
# Include ads_management only for deployments allowing reviewed writes.
# AMCP_META_SCOPES=ads_read pages_show_list pages_read_engagement business_management instagram_basic
# Optional: the Meta Graph API version, v26.0 by default. v25.0 moves every Meta request back while a v26.0 problem
# is investigated; AMCP accepts no other value.
# AMCP_META_API_VERSION=v26.0
AMCP_TIKTOK_CLIENT_ID=
AMCP_TIKTOK_CLIENT_SECRET=
AMCP_TIKTOK_REDIRECT_PARAMETER=redirect_uri
AMCP_SNAPCHAT_CLIENT_ID=
AMCP_SNAPCHAT_CLIENT_SECRET=
AMCP_LINKEDIN_CLIENT_ID=
AMCP_LINKEDIN_CLIENT_SECRET=
# Optional: the LinkedIn-Version AMCP sends, 202609 by default. Only a version AMCP has reviewed is accepted, and the
# server refuses to start with any other value; leave it unset unless you roll back to another reviewed version.
# AMCP_LINKEDIN_API_VERSION=202609
# Optional DSC scopes, only after provider product/permission approval; reconnect afterwards.
# Overrides the whole scope list; does not change existing token grants.
# AMCP_LINKEDIN_SCOPES=r_ads r_ads_reporting rw_ads w_organization_social r_organization_social
AMCP_X_CLIENT_ID=
AMCP_X_CLIENT_SECRET=
# Apple Ads API user credentials; upload the matching P-256 public key in Apple's API settings.
# PRIVATE_KEY accepts a PEM value with real newlines or literal \n escapes. Never put a real key in Git.
# This is a server-side client-credentials flow, without a browser OAuth callback.
AMCP_APPLE_CLIENT_ID=
AMCP_APPLE_TEAM_ID=
AMCP_APPLE_KEY_ID=
AMCP_APPLE_PRIVATE_KEY=
# Alternative to the signing-key fields: pre-generated Apple client-secret JWT (must be renewed manually).
AMCP_APPLE_CLIENT_SECRET=

# Private Drive media source (optional; otherwise shares Google app credentials)
AMCP_DRIVE_CLIENT_ID=
AMCP_DRIVE_CLIENT_SECRET=
# FFmpeg is included in Docker; local installations may override executable paths.
# AMCP_FFMPEG_PATH=ffmpeg
# AMCP_FFPROBE_PATH=ffprobe

# Member accounts. These credentials are independent from advertising OAuth.
AMCP_ALLOW_SIGNUP=true
# A browser that completed a sign-in keeps its own sign-in and reset budget, so others' failures cannot lock the person
# out (needs MIRROR_MASTER_KEY). false turns this off.
AMCP_KNOWN_DEVICES=true
AMCP_SIGNIN_GOOGLE_CLIENT_ID=
AMCP_SIGNIN_GOOGLE_CLIENT_SECRET=
AMCP_SIGNIN_FACEBOOK_CLIENT_ID=
AMCP_SIGNIN_FACEBOOK_CLIENT_SECRET=
# Apple Sign in: Services ID as CLIENT_ID, linked to a primary App ID.
AMCP_SIGNIN_APPLE_CLIENT_ID=
AMCP_SIGNIN_APPLE_TEAM_ID=
AMCP_SIGNIN_APPLE_KEY_ID=
AMCP_SIGNIN_APPLE_PRIVATE_KEY=
# Alternative: externally generated Apple client secret; renew before expiry.
AMCP_SIGNIN_APPLE_CLIENT_SECRET=
# Resend: verified sending domain and a sending-scoped API key.
AMCP_EMAIL_API_KEY=
AMCP_EMAIL_FROM=

# Reporting Overview: Google Sheets export by URL (Drive API + Sheets API enabled).
# OAuth requests drive.file + spreadsheets; AMCP still requires explicit destination selection.
# Both unset falls back to AMCP_GOOGLE_CLIENT_ID/SECRET. Register /api/auth/sheets/callback.
AMCP_SHEETS_CLIENT_ID=
AMCP_SHEETS_CLIENT_SECRET=
# Optional: keep fractional JSON numbers in read-only provider report responses as exact source text (default off).
# Keep it off until campaign-level overview runs of each affected platform are covered with it on (RPT-01).
# AMCP_REPORT_LOSSLESS_NUMBERS=true
# Unconfirmed Sheets deliveries resend the identical batch after a 10-minute settle window and can be released
# (audited). Set to off to roll back to poll-only reconciliation (no resend, no release).
# AMCP_SHEETS_DELIVERY_RECOVERY=on
# After the settle window the export job resends the same report by itself (D11); off waits for an operator's resend.
# AMCP_SHEETS_AUTO_RESEND=on
# Optional: the security contact /.well-known/security.txt publishes (mailto: or https:), and the date the owner last
# reviewed it for (ISO date; RFC 9116 Expires). Unset: mailto:privacy@amcp.shop and the date in server/public-assets.ts.
# AMCP_SECURITY_CONTACT=
# AMCP_SECURITY_TXT_EXPIRES=
# A manual export cannot replace another report's owned Sheets tab; off restores unrestricted manual exports.
# AMCP_SHEETS_DESTINATION_OWNERSHIP=on
# Scheduled Sheets deliveries run as their own export job; inline writes them inside the collection job again.
# AMCP_SCHEDULED_SHEETS_DELIVERY=job
# Consecutive non-retryable delivery failures that pause an Overview schedule (0 keeps it active).
# AMCP_SCHEDULE_DELIVERY_PAUSE_AFTER=3
# Nonexistent local times (daylight-saving gaps) run at the first valid time after them; skip skips them instead.
# AMCP_SCHEDULE_DST_POLICY=shift_forward
# Media staging bound in MiB (32-512); account/platform limits can be lower.
AMCP_MAX_MEDIA_MB=128
# Optional rollback for the owner spending policy (WRT-01): abort restores, during rollout only, the evaluator in which
# one unmeasurable money field hid every other amount of the request. Leave unset.
# AMCP_SPEND_POLICY_UNSUPPORTED=abort
# Optional media capacity (docs/MEDIA-UPLOADS.md#media-capacity). Defaults shown; unset keeps them.
# Shared byte budget in MiB (default six times the media limit) and the copies of a file one operation reserves.
# AMCP_MEDIA_MEMORY_MB=768
# AMCP_MEDIA_MEMORY_FACTOR=6
# AMCP_MEDIA_MIN_RESERVATION_MB=64
# Media operations at once in the deployment, and per workspace.
# AMCP_MEDIA_OPERATIONS=8
# AMCP_MEDIA_TENANT_OPERATIONS=4
# Linux only: an address-space limit in MiB for each FFmpeg/ffprobe process (runs it under prlimit). Unset: none.
# AMCP_MEDIA_PROCESS_MEMORY_MB=
# An unfinished website upload is released after this many idle minutes (1-30), never after its 30-minute deadline.
# AMCP_MEDIA_UPLOAD_IDLE_MINUTES=10
# false refuses amcp_campaign run_background; the website push then drives each upload from the page (MED-03).
# AMCP_SERVER_PUSH=true
# After a claim, a transfer (and a qualified resume) may continue this many minutes (5-180), within a website deadline.
# AMCP_MEDIA_TRANSFER_WINDOW_MINUTES=60
# Deadline-aware start: a transfer is refused before any provider request unless it can finish in time.
# AMCP_MEDIA_STEP_BUDGET_MS=5000
# AMCP_MEDIA_TRANSFER_BYTES_PER_SECOND=1048576
# AMCP_MEDIA_DEADLINE_MARGIN_MS=15000
